    "/v1/downloads/{downloadId}/file": {
      "parameters": [
        {
          "in": "path",
          "name": "downloadId",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,199}$"
          }
        }
      ],
      "get": {
        "operationId": "getDownloadFile",
        "responses": {
          "200": {
            "description": "MP4 (H.264/AAC) authorized file. Content-Length and Content-Disposition required. No redirects; 409 until ready. Streaming response, never JSON.",
            "headers": {
              "Content-Length": {
                "schema": {
                  "type": "integer"
                }
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "video/mp4": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
