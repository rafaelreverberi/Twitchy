  "components": {
    "securitySchemes": {
      "SourceBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Source-issued credential ONLY; never Twitch credentials"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "server_version": {
            "type": "string"
          },
          "api_version": {
            "type": "string",
            "enum": [
              "v1"
            ]
          }
        },
        "required": [
          "status",
          "server_version",
          "api_version"
        ],
        "additionalProperties": true
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "api_version": {
            "type": "string",
            "enum": [
              "v1"
            ]
          },
          "playback_protocols": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "hls"
              ]
            }
          },
          "live": {
            "type": "boolean"
          },
          "vod": {
            "type": "boolean"
          },
          "clips": {
            "type": "boolean"
          },
          "quality_selection": {
            "type": "boolean"
          },
          "downloads": {
            "type": "boolean"
          },
          "authorized_downloads_only": {
            "type": "boolean"
          },
          "ad_handling": {
            "type": "string",
            "description": "Informational, no guarantee; e.g. none, detection, pause. No client filtering."
          }
        },
        "required": [
          "api_version",
          "playback_protocols",
          "live",
          "vod",
          "clips",
          "quality_selection",
          "downloads",
          "authorized_downloads_only"
        ],
        "additionalProperties": true
      },
      "PlaybackRequest": {
        "type": "object",
        "properties": {
          "content_type": {
            "type": "string",
            "enum": [
              "live",
              "vod",
              "clip"
            ]
          },
          "channel_login": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]{1,25}$"
          },
          "content_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "requested_quality": {
            "type": "string",
            "default": "auto"
          },
          "preferences": {
            "type": "object",
            "properties": {
              "low_latency": {
                "type": "boolean"
              }
            },
            "required": [],
            "additionalProperties": true
          }
        },
        "required": [
          "content_type",
          "requested_quality"
        ],
        "additionalProperties": true,
        "oneOf": [
          {
            "properties": {
              "content_type": {
                "const": "live"
              }
            },
            "required": [
              "channel_login"
            ]
          },
          {
            "properties": {
              "content_type": {
                "enum": [
                  "vod",
                  "clip"
                ]
              }
            },
            "required": [
              "content_id"
            ]
          }
        ]
      },
      "PlaybackSession": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,199}$"
          },
          "hls_url": {
            "type": "string",
            "format": "uri",
            "description": "HTTPS AVPlayer-compatible HLS URL; short-lived bearer signature permitted. No long-lived source or Twitch tokens. Local HTTP only explicitly enabled by client."
          },
          "qualities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string"
          },
          "player_capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "pause",
                "seek",
                "pip"
              ]
            }
          },
          "filtering_status": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "playing",
              "buffering",
              "reconnecting",
              "unavailable",
              "paused_by_server",
              "ad_break",
              "unsupported",
              "server_error"
            ]
          }
        },
        "required": [
          "session_id",
          "hls_url",
          "qualities"
        ],
        "additionalProperties": true
      },
      "DownloadRequest": {
        "type": "object",
        "properties": {
          "content_type": {
            "type": "string",
            "enum": [
              "vod",
              "clip"
            ]
          },
          "content_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "authorization_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Opaque server-issued reference proving permission. NOT a Twitch OAuth token. Server MUST check ownership, rights, scope, expiry, and principal; a client assertion is insufficient."
          }
        },
        "required": [
          "content_type",
          "content_id",
          "authorization_reference"
        ],
        "additionalProperties": true
      },
      "DownloadJob": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,199}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "preparing",
              "ready",
              "transferring",
              "paused",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "transferred_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "total_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "error": {
            "$ref": "#/components/schemas/ProblemDetail"
          },
          "file_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional informational URL. Client uses authenticated /file endpoint."
          },
          "filename": {
            "type": "string"
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cancel",
                "retry"
              ]
            }
          }
        },
        "required": [
          "id",
          "status",
          "progress",
          "transferred_bytes"
        ],
        "additionalProperties": true
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "additionalProperties": true
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "request_id": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": true
      }
    }
  }
}
